{
  "$schema": "https://raw.githubusercontent.com/todogroup/repolinter/master/rulesets/schema.json",
  "rules": {
    "source-license-headers-exist": {
      "level": "error",
      "rule": {
        "type": "file-hash-matches",
        "options": {
          "exclude": [
            "backend-drm/**",
            "backend-rdp/**",
            "color-lcms/**",
            "desktop/**",
            "perfetto/**",
            "renderer-gl/**",
            "renderer-vulkan/**",
            "shared/**",
            "backend.h",
            "color-management.h",
            "color-operations.h",
            "color-properties.h",
            "color-representation.h",
            "color.h",
            "commit-timing.h",
            "config.h",
            "fifo.h",
            "id-number-allocator.h",
            "launcher-impl.h",
            "launcher-util.h",
            "libinput-device.h",
            "libinput-seat.h",
            "libweston-internal.h",
            "linux-dmabuf.h",
            "linux-explicit-synchronization.h",
            "linux-sync-file-uapi.h",
            "linux-sync-file.h",
            "output-capture.h",
            "pixel-formats.h",
            "pixman-renderer.h",
            "renderer-borders.h",
            "timeline.h",
            "vertex-clipping.h",
            "weston-log-internal.h",
            "weston-private.h",
            "weston.h"
          ]
        }
      }
    }
  }
}
